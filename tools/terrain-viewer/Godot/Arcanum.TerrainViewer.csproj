<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <AssemblyName>Arcanum.TerrainViewer</AssemblyName>
    <RootNamespace>Arcanum.TerrainViewer</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/Arcanum.Input.Godot/GodotInputAdapter.cs" Link="GodotInputAdapter.cs" />
    <!-- ARC-RES-2000: the relight lab's CPU normal generator, for the smoke stage's Godot-native comparison (normal maps of the same frames); one source, no copy. -->
    <Compile Include="../../../experiments/relight-lab/Core/NormalMapGenerator.cs" Link="RelightNormalMapGenerator.cs" />
    <Compile Include="../../../tests/Arcanum.TerrainViewer.Tests/GridWireFixture.cs" Link="GridWireFixture.cs" />
    <Compile Include="../../../tests/Arcanum.TerrainViewer.Tests/AreaCompositionFixture.cs" Link="AreaCompositionFixture.cs" />
    <Compile Include="../../../tests/Arcanum.TerrainViewer.Tests/AreaOwnerFixture.cs" Link="AreaOwnerFixture.cs" />
    <Compile Include="../../../tests/Arcanum.TerrainViewer.Tests/ConversationSessionFixture.cs" Link="ConversationSessionFixture.cs" />
    <ProjectReference Include="../Core/Arcanum.TerrainViewer.Core.csproj" />
    <ProjectReference Include="../../../src/Arcanum.Presentation/Arcanum.Presentation.csproj" />
  </ItemGroup>
  <!-- ARC-DEV-047: ./arcanum package sets these (as environment variables, which MSBuild reads as properties) to stamp the
       packaged commit and its date; a source run or a developer export has neither (ViewerBuildInfo). -->
  <ItemGroup Condition="'$(ArcanumPackageCommit)' != ''">
    <AssemblyMetadata Include="ArcanumPackageCommit" Value="$(ArcanumPackageCommit)" />
    <AssemblyMetadata Include="ArcanumPackageDate" Value="$(ArcanumPackageDate)" />
  </ItemGroup>
</Project>
