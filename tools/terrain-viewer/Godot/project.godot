; Engine configuration file.
config_version=5

[application]
config/name="Arcanum Terrain Viewer"
config/name.steamwoven_package="Arcanum Steamwoven"
config/use_custom_user_dir.steamwoven_package=true
config/custom_user_dir_name.steamwoven_package="Arcanum Steamwoven Game"
config/icon.steamwoven_package="res://app-icon.png"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[dotnet]
project/assembly_name="Arcanum.TerrainViewer"

[display]

[display/window]
size/viewport_width=1280
size/viewport_height=800
size/window_width_override=1280
size/window_height_override=800
resizable=true
stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.macos="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true

[rendering/rendering_device]
driver.macos="metal"

[rendering/textures]
vram_compression/import_etc2_astc=true
