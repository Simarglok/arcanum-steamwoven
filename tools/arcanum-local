#!/usr/bin/env python3
"""Private local launcher and conservative ignored-build registry."""
from __future__ import annotations

import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from tools.local_dev import config, launch, manifests, retention


def emit(value: object) -> None:
    print(json.dumps(value, indent=2, sort_keys=True))


def command_list(args: argparse.Namespace) -> None:
    value = {"tools": {name: list(tasks) for name, tasks in manifests.SUPPORTED_TOOLS.items()}}
    emit(value) if args.json else [print(f"{name}: {', '.join(tasks)}") for name, tasks in value["tools"].items()]


def command_configure(args: argparse.Namespace) -> None:
    conf = config.load_config()
    if args.configure == "discover":
        root = config.canonical_existing(args.game_root, directory=True)
        found = []
        known = {
            "modules/Arcanum.dat": (355938305, "8bddf7ae4b8f0606efd64f9137f904cfa4787d80ef85fa04d06a3def9dadc76f"),
            "arcanum1.dat": (447470816, "6dd9d10ef0932e02fc88f0eb5367b1bc37275db51d60bd68ac9bd7ef2d478576"),
            "arcanum2.dat": (147991122, "4078653c740b2b62473a6d6b60efe4c822390fc1b0958194ac0bffa1d493e24d"),
        }
        for relative, (expected_size, expected_sha256) in known.items():
            candidate = root / relative
            if candidate.is_file() and not candidate.is_symlink() and candidate.stat().st_size == expected_size and manifests.sha256(candidate) == expected_sha256:
                found.append(relative)
        conf["preferences"]["discoveredGameRoot"] = str(root)
        config.save_config(conf)
        emit({"discovered": found})
    elif args.configure == "inputs":
        conf["inputs"] = {"module": str(config.canonical_existing(args.module, directory=False)),
                          "terrainResource": str(config.canonical_existing(args.terrain_resource, directory=False)),
                          "actorResource": str(config.canonical_existing(args.actor_resource, directory=False)),
                          "prototypes": str(config.canonical_existing(args.prototypes, directory=False)),
                          "sourceId": config.safe_source_id(args.source_id or "local-input")}
        config.save_config(conf); emit({"configured": sorted(conf["inputs"])})
    else:
        root = config.canonical_existing(args.path, directory=True)
        if not args.id.replace("-", "").replace("_", "").isalnum():
            raise ValueError("artifact root id must be alphanumeric, dash, or underscore")
        conf["artifactRoots"][args.id] = str(root)
        config.save_config(conf); emit({"artifactRoot": args.id})


def selected_root(conf: dict, tool: str) -> Path:
    roots = conf.get("artifactRoots", {})
    if len(roots) != 1:
        raise ValueError("configure exactly one artifact root before launch")
    return config.canonical_existing(next(iter(roots.values())), directory=True)


def command_launch(args: argparse.Namespace) -> None:
    conf = config.load_config()
    tool = args.launch
    preview = {name: getattr(args, name) for name in launch.ACTOR_DEFAULTS}
    if tool != "terrain" and any(value is not None for value in preview.values()):
        raise ValueError("actor preview options are valid only for terrain actor-diagnostic mode")
    if tool == "terrain" and args.mode != "actor-diagnostic" and any(value is not None for value in preview.values()):
        raise ValueError("actor preview options are valid only for terrain actor-diagnostic mode")
    root = selected_root(conf, tool)
    _, manifest, _ = manifests.resolve_current(root, tool)
    executable, argv = launch.argv_from_manifest(manifest)
    if tool == "terrain":
        separator = argv.index("--")
        argv = [*argv[:separator + 1], *launch.terrain_arguments(conf.get("inputs", {}), args.mode or "terrain-only", preview)]
    emit(launch.start(executable, argv, allow_duplicate=args.allow_duplicate, lock_root=config.home(), tool=tool, dry_run=args.dry_run))


def command_builds(args: argparse.Namespace) -> None:
    conf, registry = config.load_config(), config.load_registry()
    if args.builds == "inventory":
        emit(retention.inventory(conf, registry, show_paths=args.show_paths))
    elif args.builds == "plan":
        entries = retention.inventory(conf, registry, show_paths=True)
        plan = retention.create_plan(conf, registry, entries)
        if args.output:
            Path(args.output).write_text(json.dumps(plan, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        emit(plan)
    elif args.builds == "apply":
        plan = json.loads(Path(args.plan).read_text(encoding="utf-8"))
        emit(retention.apply_plan(plan, conf, registry, accepted_id=args.accept_plan))
    elif args.builds == "accept":
        retention.accept(registry, tool=args.tool, candidate_id=args.candidate, manifest=Path(args.manifest), authority=args.authority, review=args.review)
        config.save_registry(registry); emit({"accepted": args.candidate, "tool": args.tool})
    elif args.builds == "retire":
        retention.retire(registry, args.candidate); config.save_registry(registry); emit({"retired": args.candidate})
    elif args.builds == "export-preflight":
        emit(retention.export_preflight(registry, args.tool, args.output_bytes, args.temporary_bytes))
    else:
        retention.register_export(registry, tool=args.tool, candidate_id=args.candidate, manifest=Path(args.manifest))
        config.save_registry(registry); emit({"exported": args.candidate, "tool": args.tool})


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="arcanum-local")
    top = result.add_subparsers(dest="command", required=True)
    listed = top.add_parser("list"); listed.add_argument("--json", action="store_true"); listed.set_defaults(func=command_list)
    configure = top.add_parser("configure"); configure_sub = configure.add_subparsers(dest="configure", required=True)
    discover = configure_sub.add_parser("discover"); discover.add_argument("--game-root", required=True)
    inputs = configure_sub.add_parser("inputs"); inputs.add_argument("--module", required=True); inputs.add_argument("--terrain-resource", required=True); inputs.add_argument("--actor-resource", required=True); inputs.add_argument("--prototypes", required=True); inputs.add_argument("--source-id")
    artifact = configure_sub.add_parser("add-artifact-root"); artifact.add_argument("--id", required=True); artifact.add_argument("path")
    configure.set_defaults(func=command_configure)
    launcher = top.add_parser("launch"); launcher.add_argument("launch", choices=manifests.SUPPORTED_TOOLS); launcher.add_argument("--mode", choices=("terrain-only", "combined", "actor-diagnostic")); launcher.add_argument("--allow-duplicate", action="store_true"); launcher.add_argument("--dry-run", action="store_true")
    for option in launch.ACTOR_DEFAULTS:
        launcher.add_argument("--" + option.replace("_", "-"))
    launcher.set_defaults(func=command_launch)
    builds = top.add_parser("builds"); build_sub = builds.add_subparsers(dest="builds", required=True)
    inventory = build_sub.add_parser("inventory"); inventory.add_argument("--show-paths", action="store_true")
    plan = build_sub.add_parser("plan"); plan.add_argument("--output")
    apply = build_sub.add_parser("apply"); apply.add_argument("--plan", required=True); apply.add_argument("--accept-plan", required=True)
    accept = build_sub.add_parser("accept"); accept.add_argument("--tool", required=True, choices=manifests.SUPPORTED_TOOLS); accept.add_argument("--candidate", required=True); accept.add_argument("--manifest", required=True); accept.add_argument("--authority", required=True); accept.add_argument("--review", required=True)
    retire = build_sub.add_parser("retire"); retire.add_argument("--candidate", required=True)
    preflight = build_sub.add_parser("export-preflight"); preflight.add_argument("--tool", required=True, choices=manifests.SUPPORTED_TOOLS); preflight.add_argument("--output-bytes", type=int); preflight.add_argument("--temporary-bytes", type=int)
    register = build_sub.add_parser("register-export"); register.add_argument("--tool", required=True, choices=manifests.SUPPORTED_TOOLS); register.add_argument("--candidate", required=True); register.add_argument("--manifest", required=True)
    builds.set_defaults(func=command_builds)
    return result


def main() -> int:
    try:
        args = parser().parse_args()
        args.func(args)
        return 0
    except (OSError, ValueError) as error:
        print(f"arcanum-local: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
