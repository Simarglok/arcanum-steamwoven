{
  "version": 1,
  "note": "Text-only prompt library of the Steamwoven kit (TRD SWI-GEN-3). Each prompt id names a text file; the composed prompt is common.txt + the file with its placeholders filled; its sha256 goes into the provenance record (SWI-GEN-6). No pixels here.",
  "common": "common.txt",
  "placeholders": [
    "part_id",
    "part_note",
    "width",
    "height"
  ],
  "reference_slots": {
    "original": "the original art of the screen or part, scaled to the master size, given as the image to edit and as the layout truth (original art is a Codex input, owner decision 2026-11-16)",
    "context": "the approved context image (whole screen) or a crop of it that shows where the part is used",
    "sheet": "the approved material sheet or the swatch of this part's material",
    "plate": "the approved button plate that a state overlay belongs to"
  },
  "context_screens": [
    "ctx-hud",
    "ctx-inventory",
    "ctx-character",
    "ctx-logbook",
    "ctx-schematic",
    "ctx-reading",
    "ctx-main-menu"
  ],
  "batches": {
    "style-anchors-contexts": {
      "prompts": [
        "ctx-hud",
        "ctx-inventory",
        "ctx-character",
        "ctx-logbook",
        "ctx-schematic",
        "ctx-reading",
        "ctx-main-menu"
      ],
      "after": null
    },
    "style-anchors-sheet": {
      "prompts": [
        "mat-sheet"
      ],
      "after": "style-anchors-contexts approved by the owner"
    }
  },
