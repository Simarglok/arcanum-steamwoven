; Engine configuration file.
; Generated and maintained as the minimal ARC-RENDER-001 presentation project.
config_version=5

[application]
config/name="Arcanum Steamwoven Viewer"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[dotnet]

project/assembly_name="Arcanum.Godot"

[display]

[display/window]
size/viewport_width=1280
size/viewport_height=800
size/window_width_override=1280
size/window_height_override=800
resizable=true
stretch/mode="canvas_items"
handheld/orientation=1

[display/window/size]
resizable=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0

[rendering/textures]

vram_compression/import_etc2_astc=true

[gui]
theme/default_font_multichannel_signed_distance_field=true
