#!/usr/bin/env python3
"""Project launcher: one command for the ordinary diagnostic viewer modes and the function oracle.

A thin wrapper over tools/arcanum-local; every check (identities, artifact authority,
ordinary-launch policy) stays there. Rule: when a viewer mode gains or changes an input,
update tools/local_dev/launch.py (GAME_ROLES/MODE_ROLES/ROLE_FLAGS) in the same PR.
"""
from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from tools.local_dev import clean, config, daily, launch, manifests, run_queue, smoke, start_check  # noqa: E402

LOCAL = ROOT / "tools" / "arcanum-local"
DEFAULT_GAME_ROOT = Path("/Applications/Arcanum")
ROOT_ID = "world"
# Mode -> (viewer --mode, exact artifact tasks in preference order). The first task with a current pointer is launched.
# ARC-RENDER-028: the pinned Crash Site exterior is no longer a launcher mode (`area` is map mode, below); the viewer keeps
# its pinned profile as a regression smoke only.
MODES = {"world": ("world-diagnostic", ("ARC-WORLD-003",))}
# ARC-RENDER-017: `map NAME` shows one whole interior in crash-site-area map mode; only an ARC-RENDER-008 build
# exported with map mode understands it (an older one refuses the arguments). ARC-DEV-015: a universal build, exported
# without the pinned Crash Site gates, is preferred; it runs on any installation.
MAP_MODE = ("crash-site-area", (launch.UNIVERSAL_TASK, "ARC-RENDER-008"))
# ARC-RENDER-028: `area` is map mode on the main world map, opened as a window around its map-list start (the Crash Site).
AREA_MAP = "Arcanum1-024-fixed"
# ARC-UI-012: `area` opens the main menu first, as the game does; builds exported before the menu (ARC-UI-011, merged in
# this commit) refuse its argument, so such a build is refused here with the way out.
MAIN_MENU_COMMIT = "309d1236ba3a0a9ed554bc86c696090c3e661d8b"
# ARC-DEV-050: the debug mode's `--debug-mode` (added in this commit); older builds refuse it as an argument.
DEBUG_MODE_COMMIT = "33748757d4aaf24ebccb41c1842c27b3a0626797"


def main_checkout() -> Path:
    try:
        common = subprocess.check_output(["git", "-C", str(ROOT), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                                         text=True, stderr=subprocess.DEVNULL).strip()
    except (OSError, subprocess.CalledProcessError) as error:
        raise ValueError("run ./arcanum from a git checkout of the project") from error
    return Path(common).parent


def local(*arguments: str) -> int:
    return subprocess.call([sys.executable, "-B", str(LOCAL), *arguments])


def setup(args: argparse.Namespace) -> int:
    code = local("configure", "discover", "--game-root", str(args.game_root), "--write-inputs")
    if code != 0:
        return code
    artifacts = main_checkout() / "artifacts" / "world-builds"
    clean.write_marker(artifacts.parent)  # ARC-DEV-028: the local do-not-delete note (docs/workflow/build-retention.md)
    if config.load_config().get("artifactRoots", {}).get(ROOT_ID) != str(artifacts.resolve()):
        if not artifacts.is_dir():
            print(f"No exported viewer builds yet under {artifacts}; run an export endpoint first.", file=sys.stderr)
            return 2
        return local("configure", "add-artifact-root", "--id", ROOT_ID, str(artifacts))
    return 0


def main_menu_requested(args: argparse.Namespace) -> bool:
    """ARC-UI-012: `area` opens the main menu unless --no-main-menu or --hero (a hero start has no menu) says otherwise;
    `map` opens it only with --main-menu."""
    if getattr(args, "main_menu", False):
        return True
    return args.mode == "area" and not getattr(args, "no_main_menu", False) and not getattr(args, "hero", None)


def build_holds(manifest: dict, change: str) -> bool:
    """True when the build's commit contains `change` in this checkout's history (an unknown commit is not trusted)."""
    try:
        commit = manifests.manifest_candidate(manifest)
    except ValueError:
        return False
    try:
        return subprocess.call(["git", "-C", str(ROOT), "merge-base", "--is-ancestor", change, commit],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0
    except OSError:
        return False


def build_has_main_menu(manifest: dict) -> bool:
    """True when the build's commit contains the main menu (ARC-UI-011) in this checkout's history."""
    return build_holds(manifest, MAIN_MENU_COMMIT)


def build_has_debug_mode(manifest: dict) -> bool:
    """True when the build's commit contains the debug mode's argument (ARC-DEV-050) in this checkout's history."""
    return build_holds(manifest, DEBUG_MODE_COMMIT)


def run(args: argparse.Namespace) -> int:
    mode, tasks = MAP_MODE if args.mode in ("map", "area") else MODES[args.mode]
    name = AREA_MAP if args.mode == "area" else getattr(args, "name", None)
    main_menu = args.mode in ("map", "area") and main_menu_requested(args)
    extra = (("--area-map", name) if args.mode in ("map", "area") else ()) + (("--hero", args.hero) if getattr(args, "hero", None) else ()) \
        + (("--area-map-sector", args.sector) if getattr(args, "sector", None) else ()) \
        + (("--main-menu",) if main_menu else ()) \
        + (("--debug-mode",) if getattr(args, "debug_mode", False) else ())
    roots = config.load_config().get("artifactRoots", {})
    if not isinstance(roots, dict) or not isinstance(roots.get(ROOT_ID), str):
        print("Run ./arcanum setup first.", file=sys.stderr)
        return 2
    # The task's own current pointer names the build; never timestamps or directory order.
    # Tasks are tried in their fixed preference order; only a missing build falls through.
    for index, task in enumerate(tasks):
        try:
            manifest_path, manifest, _ = manifests.resolve_current(Path(roots[ROOT_ID]), "terrain", root_id=ROOT_ID, selected_task=task)
            break
        except ValueError:
            if index == len(tasks) - 1:
                raise
    if main_menu and not build_has_main_menu(manifest):
        print("The current build was not exported from a commit that holds the main menu (ARC-UI-011; an older build, or a "
              "commit this checkout does not hold) and may not open it: export a fresh "
              f"{launch.UNIVERSAL_TASK} build, or run ./arcanum {args.mode} with --no-main-menu"
              + (" (or without --main-menu)" if args.mode == "map" else "") + ".", file=sys.stderr)
        return 2
    if getattr(args, "debug_mode", False) and not build_has_debug_mode(manifest):
        print("The current build was not exported from a commit that holds the debug mode (ARC-DEV-050; an older build, or a "
              f"commit this checkout does not hold) and may not accept it: export a fresh {launch.UNIVERSAL_TASK} build, or run "
              f"./arcanum {args.mode} without --debug-mode.", file=sys.stderr)
        return 2
    candidate = f"{ROOT_ID}:{task}:{manifest_path.parent.name}"
    # A real run leaves the terrain launch selection on this build (as `tools/arcanum-local configure
    # select-launch` would); a dry run restores the previous selection afterwards.
    selection = config.load_config().get("launchSelection", {})
    previous = selection.get("terrain") if isinstance(selection, dict) else None
    code = local("configure", "select-launch", "--tool", "terrain", "--candidate", candidate)
    if code != 0:
        return code
    try:
        if args.dry_run or args.no_queue:
            return local("launch", "terrain", "--mode", mode, *extra, *(["--dry-run"] if args.dry_run else []))
        # ARC-DEV-033: the owner's viewer takes the Godot slot first in line (after the run holding it) and keeps it
        # until the window closes, so it neither waits behind the lanes' queue nor opens over a lane's smoke.
        return run_queue.run("window", [sys.executable, "-B", str(LOCAL), "launch", "terrain", "--mode", mode, *extra],
                             label=f"owner {args.mode}", timeout=0, priority=run_queue.FRONT,
                             hold=lambda: run_queue.wait_unlocked(config.home() / "locks" / "terrain.lock"))
    finally:
        if args.dry_run and previous != candidate:
            conf = config.load_config()
            restored = conf.setdefault("launchSelection", {})
            if previous is None:
                restored.pop("terrain", None)
            else:
                restored["terrain"] = previous
            config.save_config(conf)


def original_exe(explicit: Path | None) -> Path:
    """The executable for the oracle: --exe, else $ARCANUM_EXE, else the configured game folder, else the default install."""
    if explicit:
        return explicit
    if os.environ.get("ARCANUM_EXE"):
        return Path(os.environ["ARCANUM_EXE"])
    inputs = config.load_config().get("inputs", {})
    game_root = inputs.get("gameRoot") if isinstance(inputs, dict) else None
    return Path(game_root if isinstance(game_root, str) else DEFAULT_GAME_ROOT) / launch.ORIGINAL_EXE_NAME


def dotnet() -> str:
    root = os.environ.get("DOTNET_ROOT") or str(Path.home() / ".local" / "share" / "dotnet")
    return os.environ.get("DOTNET") or str(Path(root) / "dotnet")


def oracle(args: argparse.Namespace) -> int:
    """ARC-DEV-007: generate the original's outputs for the chosen functions, then run their OriginalExe tests."""
    functions = [args.function] if args.function else list(launch.ORACLE_FUNCTIONS)
    exe = original_exe(args.exe).resolve()
    out = ROOT / "research-private" / "oracle"
    generate = [sys.executable, "-B", str(ROOT / "tools" / "original-oracle" / "oracle.py"), "generate", "--exe", str(exe),
                "--out", str(out), "--seed", str(args.seed)]
    for function in functions:
        generate += ["--function", function]
    code = subprocess.call(generate)
    if code != 0:
        return code
    # ARC-DEV-008: each OriginalExe test writes its receipt (seed, inputs, mutants, result, executable and IL hashes) into
    # docs/verification/receipts; commit the receipts of a run whose functions changed.
    environment = dict(os.environ, ARCANUM_EXE=str(exe), ARCANUM_ORACLE_DIR=str(out), ARCANUM_ORACLE_REQUIRED="1",
                       ARCANUM_ORACLE_RECEIPTS=str(ROOT / launch.ORACLE_RECEIPTS))
    environment.setdefault("DOTNET_ROOT", str(Path(dotnet()).parent))
    project = str(ROOT / launch.ORACLE_TESTS)
    code = subprocess.call([dotnet(), "restore", project, "--locked-mode"], env=environment)
    if code != 0:
        return code
    names = "|".join(f"Name={launch.ORACLE_FUNCTIONS[function]}" for function in functions)
    return subprocess.call([dotnet(), "test", project, "--no-restore", "--filter", f"TestCategory=OriginalExe&({names})",
                            "--logger", "console;verbosity=detailed"], env=environment)


def queued(args: argparse.Namespace) -> int:
    """ARC-DEV-033: run one command through the launch queue (docs/workflow/toolchain.md#launch-queue-arc-dev-033)."""
    command = args.cmd[1:] if args.cmd[:1] == ["--"] else args.cmd
    # ARC-DEV-059: a quiet run checks its own start (docs/workflow/toolchain.md#checking-that-a-run-started-arc-dev-029).
    check = start_check.for_run(args.kind, args.expect, args.start_within, command)
    if check is not None and args.verbose and not os.environ.get(run_queue.TICKET_ENV):  # a nested run is never checked
        run_queue.say("note: a --verbose run has no start check; check its start yourself")
    return run_queue.run(args.kind, command, label=args.label or "", timeout=args.timeout, quiet=not args.verbose,
                         start=check)


def package_build(args: argparse.Namespace) -> int:
    """ARC-DEV-047: the packaged alpha from a fresh commit of origin/main into artifacts/packages (docs/workflow/packaging.md)."""
    command = [sys.executable, "-B", str(ROOT / "tools" / "local_dev" / "package.py"), args.platform, "--ref", args.ref,
               *(["--no-fetch"] if args.no_fetch else []), *(["--no-smoke"] if args.no_smoke else []),
               *(["--keep-work"] if args.keep_work else []), *(["--map-smoke", args.map_smoke] if args.map_smoke else [])]
    return run_queue.run("export", command, label=f"package {args.platform}", quiet=not args.verbose)


def positive(value: str) -> int:
    number = int(value)
    if number <= 0:
        raise argparse.ArgumentTypeError("N must be a positive number")
    return number


def queue(args: argparse.Namespace) -> int:
    for line in run_queue.status(args.history):
        print(line)
    return 0


def cleanup(args: argparse.Namespace) -> int:
    """ARC-DEV-028/055: which builds and player packages are protected and which are disposable; removes only with --apply."""
    return local("builds", "clean", "--checkout", str(main_checkout()), *(["--apply"] if args.apply else []),
                 *(["--json"] if args.json else []))


def status(_: argparse.Namespace) -> int:
    conf = config.load_config()
    inputs = conf.get("inputs", {}) if isinstance(conf.get("inputs"), dict) else {}
    roots = conf.get("artifactRoots", {})
    for name, (mode, tasks) in MODES.items():
        # A task's own roles (TASK_ROLES) count when `run` would choose its build (none of the remaining modes has any).
        chosen = None
        if isinstance(roots, dict) and isinstance(roots.get(ROOT_ID), str):
            for task in tasks:
                try:
                    manifests.resolve_current(Path(roots[ROOT_ID]), "terrain", root_id=ROOT_ID, selected_task=task)
                except ValueError:
                    continue
                chosen = task
                break
        extra = launch.TASK_ROLES.get(chosen, ()) if chosen else ()
        missing = [role for role in launch.MODE_ROLES[mode] + extra + ("sourceId",) if role not in inputs]
        build = f" ({chosen} build)" if chosen else ""
        # ARC-DEV-015: the pinned modes need their pinned roles to match the pinned identity (setup's installation record).
        verified = launch.verified_roles(conf)
        differ = [role for role in launch.pinned_roles(mode, chosen) if verified is not None and role in inputs and role not in verified]
        state = ("missing " + ", ".join(missing) + " (run ./arcanum setup)" if missing
                 else "pinned identity differs: " + ", ".join(differ) + " (this mode is the pinned Crash Site regression; use map)" if differ
                 else "ready")
        print(f"{name}{build}: {state}")
    missing = [role for role in launch.MAP_ROLES + ("sourceId",) if role not in inputs]
    print(f"map: {'ready' if not missing else 'missing ' + ', '.join(missing) + ' (run ./arcanum setup)'} "
          f"(needs an {launch.UNIVERSAL_TASK} or ARC-RENDER-008 build with map mode; any installation)")
    print(f"area: {'ready' if not missing else 'missing ' + ', '.join(missing) + ' (run ./arcanum setup)'} "
          f"(map mode on {AREA_MAP} at the Crash Site; same build and inputs as map)")
    print(f"heroes (area/map --hero NAME, needs an {launch.UNIVERSAL_TASK} or ARC-RENDER-008 build with the hero start):",
          ", ".join(launch.PREMADE_HEROES))
    exe = original_exe(None)
    print(f"oracle: {'ready' if exe.is_file() else 'missing ' + str(exe) + ' (set ARCANUM_EXE)'} ({len(launch.ORACLE_FUNCTIONS)} functions)")
    print("selection:", conf.get("launchSelection", {}).get("terrain", "none"))
    return 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(prog="arcanum", description="Launch the Arcanum Steamwoven diagnostic viewer.")
    commands = result.add_subparsers(dest="command", required=True)
    configure = commands.add_parser("setup", help="find the installed game's inputs, record their identities and configure the launcher")
    configure.add_argument("--game-root", type=Path, default=DEFAULT_GAME_ROOT)
    configure.set_defaults(func=setup)
    for name, (mode, tasks) in MODES.items():
        command = commands.add_parser(name, help=f"launch --mode {mode} from the current {' or '.join(tasks)} build")
        command.add_argument("--dry-run", action="store_true")
        command.add_argument("--no-queue", action="store_true", help="start at once instead of taking the launch queue's Godot slot")
        command.set_defaults(func=run, mode=name)
    # ARC-RENDER-028: the Crash Site in the universal map mode (the main world map's window around its map-list start).
    command = commands.add_parser("area", help=f"launch the main world map ({AREA_MAP}) at the Crash Site from the current "
                                  f"{launch.UNIVERSAL_TASK} or ARC-RENDER-008 build (map mode; the window moves with the actor), "
                                  "with the main menu first unless --no-main-menu or --hero")
    command.add_argument("--sector", help="X,Y: open the main map at this sector instead of the Crash Site")
    command.add_argument("--hero", choices=launch.PREMADE_HEROES, help="start as this pre-made hero (default: the diagnostic PC profile)")
    menu = command.add_mutually_exclusive_group()
    menu.add_argument("--main-menu", action="store_true", help="open the main menu first (the default without --hero; ARC-UI-012); not with --hero")
    menu.add_argument("--no-main-menu", action="store_true", help="start playing at once with the diagnostic PC profile, without the main menu")
    command.add_argument("--debug-mode", action="store_true", help="debug mode (ARC-DEV-050): the world map (W) lists every area and teleports there; not gameplay")
    command.add_argument("--dry-run", action="store_true")
    command.add_argument("--no-queue", action="store_true", help="start at once instead of taking the launch queue's Godot slot")
    command.set_defaults(func=run, mode="area")
    command = commands.add_parser("map", help=f"launch one map (a maps/ folder name) from the current {launch.UNIVERSAL_TASK} or ARC-RENDER-008 build; "
                                  "the main world map (Arcanum1-024-fixed) opens as a window that moves with the actor")
    command.add_argument("name", help='the map folder name, e.g. "crash site cave" or Arcanum1-024-fixed')
    command.add_argument("--sector", help="X,Y: open the map at this sector (default: the transfer arrival or the map-list start)")
    command.add_argument("--hero", choices=launch.PREMADE_HEROES, help="start as this pre-made hero (default: the diagnostic PC profile)")
    command.add_argument("--main-menu", action="store_true", help="open the main menu first (new game with a pre-made hero, last save, load); not with --hero")
    command.add_argument("--debug-mode", action="store_true", help="debug mode (ARC-DEV-050): the world map (W) lists every area and teleports there; not gameplay")
    command.add_argument("--dry-run", action="store_true")
    command.add_argument("--no-queue", action="store_true", help="start at once instead of taking the launch queue's Godot slot")
    command.set_defaults(func=run, mode="map")
    command = commands.add_parser("oracle", help="run the function oracle on the installed Arcanum.exe, then the OriginalExe tests")
    which = command.add_mutually_exclusive_group()
    which.add_argument("--function", choices=list(launch.ORACLE_FUNCTIONS), metavar="ADDR",
                       help="one function: " + ", ".join(launch.ORACLE_FUNCTIONS))
    which.add_argument("--all", action="store_true", help="every oracle function (the default)")
    command.add_argument("--exe", type=Path, help="the installed Arcanum.exe (default: $ARCANUM_EXE or the game folder)")
    command.add_argument("--seed", type=int, default=20261017)
    command.set_defaults(func=oracle)
    command = commands.add_parser("clean", help="show which builds and player packages are protected and which are disposable (dry run); --apply removes only the disposable payloads and outdated packages")
    command.add_argument("--apply", action="store_true", help="retire superseded builds, remove the disposable .app payloads and the outdated player packages (previous/)")
    command.add_argument("--json", action="store_true")
    command.set_defaults(func=cleanup)
    commands.add_parser("status", help="show which modes have every input configured").set_defaults(func=status)
    command = commands.add_parser("run", help="run one command through the FIFO launch queue: Godot runs one at a time in "
                                  "arrival order, an export also waits for running dotnet runs (ARC-DEV-033); a quiet Godot run "
                                  "checks its own start and fails one that did not start (ARC-DEV-059)")
    command.add_argument("--kind", required=True, choices=run_queue.KINDS,
                         help="window: Godot with a window; headless: Godot --headless or an import; export: an export "
                              "endpoint; dotnet: dotnet build/test (runs alongside others, waits only for an export)")
    command.add_argument("--timeout", type=float, metavar="MIN",
                         help="minutes before the run is stopped (default " + ", ".join(
                             f"{kind} {value:g}" for kind, value in run_queue.DEFAULT_TIMEOUT_MINUTES.items()) + "; 0: no limit)")
    command.add_argument("--label", help="a short note shown in ./arcanum queue")
    command.add_argument("--expect", metavar="REGEX",
                         help="the start line the command prints when it started the intended mode (ARC-DEV-059); "
                              "replaces the defaults of window, headless and export runs (the viewer's start, the "
                              "self-test's first stage, the export steps) and gives a dotnet run a start check")
    command.add_argument("--start-within", type=float, metavar="SEC",
                         help=f"seconds from the command's start to its start line (default "
                              f"{start_check.DEFAULT_WINDOW_SECONDS:g}; 0: no start check); a usage error before it, no "
                              f"start line in time, or a non-zero end before it fails the run (exit "
                              f"{start_check.FAILED_START_EXIT} when it was stopped); an end with 0 before it passes "
                              f"with a note")
    command.add_argument("--verbose", action="store_true",
                         help="stream the command's output here instead of the quiet default (ARC-DEV-037): the whole "
                              "output goes to a log file and only PASS or FAIL with the first error is printed; a "
                              "--verbose run has no start check")
    command.add_argument("cmd", nargs=argparse.REMAINDER, metavar="-- COMMAND", help="the command and its arguments, after --")
    command.set_defaults(func=queued)
    # ARC-DEV-061: the shared smoke runner (docs/workflow/toolchain.md#smoke-runner-arc-dev-061).
    command = commands.add_parser("smoke", help="run the viewer's smokes from this checkout through the launch queue, each "
                                  "with its own settings folder and start check: pr (Crash Site + touched stages), full (the "
                                  "full map smoke chain), map NAME, crash-site, self-test (ARC-DEV-061)")
    smoke.configure(command)
    command.set_defaults(func=smoke.run)
    command = commands.add_parser("package", help="build the packaged alpha for a player from a fresh commit of origin/main "
                                  "into artifacts/packages/PLATFORM (ARC-DEV-047/048; through the launch queue as an export)")
    command.add_argument("platform", choices=("mac", "win"), help="mac: Arcanum Steamwoven.app, ad-hoc signed; win: the Windows "
                         "11 x64 folder (Arcanum Steamwoven.exe, unsigned) as one zip, file checks only (ARC-DEV-048)")
    command.add_argument("--ref", default="origin/main", help="the commit to package (default origin/main, fetched first)")
    command.add_argument("--no-fetch", action="store_true", help="do not fetch origin main first")
    command.add_argument("--no-smoke", action="store_true", help="skip the launcher and main menu smoke on the exported app")
    command.add_argument("--keep-work", action="store_true", help="keep the temporary source and export folder for a look")
    command.add_argument("--verbose", action="store_true", help="stream the build's step lines here instead of the quiet default")
    command.add_argument("--map-smoke", metavar="TEXT", help="the full map smoke chain's result for BUILD.txt (./arcanum daily "
                         "passes it; default: NOT RUN)")
    command.set_defaults(func=package_build)
    # ARC-DEV-062: the daily package build (docs/workflow/packaging.md#daily-package-build-arc-dev-062).
    command = commands.add_parser("daily", help="the daily package build: when origin/main changed since the last package, "
                                  "its root checks, the full map smoke chain and both player packages, from a fresh worktree "
                                  "of that commit (ARC-DEV-062)")
    daily.configure(command)
    command.set_defaults(func=daily.run)
    command = commands.add_parser("queue", help="show the launch queue: the runs holding a place and the waiters in order")
    command.add_argument("--history", type=positive, default=0, metavar="N", help="show the last N finished runs instead")
    command.set_defaults(func=queue)
    return result


if __name__ == "__main__":
    arguments = parser().parse_args()
    try:
        raise SystemExit(arguments.func(arguments))
    except ValueError as error:
        print(f"arcanum: {error}", file=sys.stderr)
        raise SystemExit(2)
