<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AssemblyName>AudioLab.Core</AssemblyName></PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'ExportDebug'">
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/locks/$(Configuration)/$(RuntimeIdentifier)/packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <Target Name="ValidateAudioExportRuntime" BeforeTargets="_GenerateRestoreProjectSpec" Condition="'$(Configuration)' == 'ExportDebug'">
    <Error Condition="'$(RuntimeIdentifier)' != 'osx-x64' and '$(RuntimeIdentifier)' != 'osx-arm64'" Text="Audio lab ExportDebug requires osx-x64 or osx-arm64." />
  </Target>
</Project>
