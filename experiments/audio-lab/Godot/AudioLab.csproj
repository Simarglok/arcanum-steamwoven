<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup><AssemblyName>AudioLab</AssemblyName><RootNamespace>AudioLab.Godot</RootNamespace><TargetFramework>net8.0</TargetFramework></PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'ExportDebug'">
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/locks/$(Configuration)/$(RuntimeIdentifier)/packages.lock.json</NuGetLockFilePath>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <Target Name="ValidateAudioExportRuntime" BeforeTargets="_GenerateRestoreProjectSpec;PrepareForBuild" Condition="'$(Configuration)' == 'ExportDebug'">
    <Error Condition="'$(RuntimeIdentifier)' != 'osx-x64' and '$(RuntimeIdentifier)' != 'osx-arm64'" Text="Audio lab ExportDebug requires osx-x64 or osx-arm64." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../Core/AudioLab.Core.csproj" />
    <Compile Include="../Synthetic/SyntheticWave.cs" Link="SyntheticWave.cs" />
  </ItemGroup>
</Project>
