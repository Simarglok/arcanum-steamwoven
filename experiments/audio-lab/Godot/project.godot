; Independently authored synthetic-only standalone audio diagnostic.
config_version=5

[application]
config/name="Synthetic Audio Lab"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="SteamwovenSyntheticAudioLab"

[dotnet]
project/assembly_name="AudioLab"

[display/window]
size/viewport_width=1000
size/viewport_height=650
size/window_width_override=1000
size/window_height_override=650

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[rendering/textures]
vram_compression/import_etc2_astc=true
