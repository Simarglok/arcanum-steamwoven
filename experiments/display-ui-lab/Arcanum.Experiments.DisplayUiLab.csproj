<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <AssemblyName>Arcanum.Experiments.DisplayUiLab</AssemblyName>
    <RootNamespace>Arcanum.Experiments.DisplayUiLab</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RestorePackagesWithLockFile Condition="'$(GodotTargetPlatform)' == ''">true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(GodotTargetPlatform)' != ''">$(BaseIntermediateOutputPath)godot.packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
