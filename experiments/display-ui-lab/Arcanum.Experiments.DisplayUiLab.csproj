<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <AssemblyName>Arcanum.Experiments.DisplayUiLab</AssemblyName>
    <RootNamespace>Arcanum.Experiments.DisplayUiLab</RootNamespace>
    <TargetFramework>net8.0</TargetFramework>
    <!-- The literal Debug restore is canonical and owns the committed project lock. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Export configurations may update their own generated lock without touching Debug's committed lock. -->
    <NuGetLockFilePath Condition="'$(Configuration)' == 'ExportDebug' Or '$(Configuration)' == 'ExportRelease'">$(BaseIntermediateOutputPath)locks/$(Configuration)/$(GodotTargetPlatform)/$(RuntimeIdentifier)/packages.lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
